<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<RootNamespace>Bcd</RootNamespace>
		<Authors>Murali Krishna KUNAPAREDDY</Authors>
		<Company>BCD</Company>
		<PackageId>ColoredConsole.NET</PackageId>
		<Product>aBCDe's ColoredConsole</Product>
		<Description>A richly-formatted console library for C# — colored text, bordered boxes, section headers, separators, prompts, progress bars, and file logging.</Description>
		<Copyright>2024-2026</Copyright>
		<Version>2.0.0</Version>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReleaseNotes>v2.0.0 — Breaking changes: namespace renamed Bcd; Theme and WriteOptions types added; DrawSectionHeader replaces DrawSeparator(string); IDisposable logging; word-aware wrapping; bug fixes.</PackageReleaseNotes>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<Title>ColoredConsole.NET</Title>
	</PropertyGroup>
	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

</Project>
